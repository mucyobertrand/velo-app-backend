# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/velo?schema=public"

PORT=3000

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"

# Secret used to sign reports (HMAC). Use a long random string and never change it
# after reports are issued, or old reports will stop verifying.
REPORT_SIGNING_SECRET="change-me-too"

# Key required in the "x-admin-key" header for admin endpoints
# (issuing license codes, managing parsing rules, revoking reports).
ADMIN_API_KEY="change-me-admin"

# OTP settings
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Ed25519 keypair for signing reports (base64-encoded PEM).
# Generate with: npm run keys:generate
REPORT_PRIVATE_KEY_B64=""
REPORT_PUBLIC_KEY_B64=""

# Public base URL used in report QR codes / verify links.
PUBLIC_URL="http://localhost:3000"
